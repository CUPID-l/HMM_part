# ============================================================================
# Project-Specific: Data Files
# ============================================================================
# Raw market data (large files)
data/raw/**/*.csv
data/raw/**/*.parquet
data/raw/**/*.json
data/raw/**/*.feather
data/raw/**/*.h5
data/raw/**/*.hdf5

# Processed data
data/processed/**/*.csv
data/processed/**/*.parquet
data/processed/**/*.json
data/processed/**/*.feather

# Keep directory structure but ignore contents
!data/raw/.gitkeep
!data/processed/.gitkeep

# Temporary data files
data/tmp/
data/temp/
*.tmp

# ============================================================================
# Project-Specific: Model Files
# ============================================================================
# Trained models (can be large)
models/*.joblib
models/*.pkl
models/*.pickle
models/*.h5
models/*.pt
models/*.pth

# Keep demo model for testing
!models/demo_model.joblib

# Model checkpoints
models/checkpoints/
*.ckpt

# Keep directory structure
!models/.gitkeep

# ============================================================================
