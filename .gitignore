# ============================================================================
# Prediction outputs
predictions_*.json
backtest_*.json
!predictions.json  # Keep example/template

# Result files
results/**/*.csv
results/**/*.json
results/**/*.png
results/**/*.pdf
results/**/*.html

# Keep directory structure
!results/.gitkeep

# Logs
logs/*.log
logs/**/*.log
*.log
!logs/.gitkeep

