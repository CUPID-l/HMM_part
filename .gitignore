# ============================================================================
# Keep These Files/Folders
# ============================================================================
# Keep directory structure with .gitkeep files
!.gitkeep

# Keep configuration templates
!config/default.yaml
!config/README.md

# Keep example files
!data/example_data.csv

# Keep documentation
!README.md
!QUICKSTART*.md
!MIGRATION_GUIDE.md
!IMPLEMENTATION*.md
!PRIORITY*.md

# Keep requirements
!requirements.txt
!setup.py
!pytest.ini

# Keep test files
!tests/
!test_*.py

# Keep source code
!src/
!hmm_cli.py
!doit.py
!validate_system.py
!run_tests.py
