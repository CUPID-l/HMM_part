# Environment variables for HMM Market Regime Detection
# Copy this file to .env and update with your actual API key

# Alpha Vantage API Key (required for data ingestion)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional: Logging configuration
LOG_LEVEL=INFO
LOG_FILE=hmm_system.log

# Optional: Default data directories
DATA_DIR=data
MODELS_DIR=models
RESULTS_DIR=results
